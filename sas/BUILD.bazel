load("@rules_cc//cc:defs.bzl" ,"cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "sas_config_lib",
    hdrs = [
        "SasConfig.h",
    ],
    srcs = [
        "SasConfig.cpp",
    ],
)

cc_library(
    name = "sas_input_lib",
    hdrs = [
        "SasInput.h",
    ],
    srcs = [
        "SasInput.cpp",
    ],
    deps = [
        ":sas_config_lib",
    ]
)

cc_library(
    name = "sas_model_lib",
    hdrs = [
        "SasModel.h",
        "token.txt",
        "opinfo.txt",
    ],
    srcs = [
        "SasModel.cpp",
    ],
    deps = [
        ":sas_config_lib",
    ]
)

cc_library(
    name = "sas_lexico_lib",
    hdrs = [
        "SasLexico.h",
        "token.txt",
        "opinfo.txt",
    ],
    srcs = [
        "SasLexico.cpp",
        "TokenScanner.cpp",
    ],
    deps = [
        ":sas_input_lib",
        ":sas_model_lib",
    ]
)


cc_library(
    name = "sas_expr_lib",
    hdrs = [
        "SasExpr.h",
    ],
    deps = [
        ":sas_lexico_lib",
    ]
)

cc_library(
    name = "sas_expr_parser_lib",
    hdrs = [
        "token.txt",
        "opinfo.txt",
        "tokenop.txt",
    ],
    srcs = [
        "ExprParser.cpp",
    ],
    deps = [
        ":sas_expr_lib",
    ]
)

# Header-only evaluation of the elementary functions (sin, log, tanh, ...).
cc_library(
    name = "sas_math_functions_lib",
    hdrs = [
        "MathFunctions.h",
    ],
)

cc_library(
    name = "sas_model_parser_lib",
    hdrs = [
        "token.txt",
        "opinfo.txt",
        "tokenop.txt",
    ],
    srcs = [
        "ModelParser.cpp",
    ],
    deps = [
        ":sas_expr_parser_lib",
        ":sas_math_functions_lib",
    ]
)

# Evaluation, time events and specialization of hybrid (discrete + continuous) models.
cc_library(
    name = "sas_hybrid_model_lib",
    hdrs = [
        "HybridModel.h",
    ],
    srcs = [
        "HybridModel.cpp",
    ],
    deps = [
        ":sas_math_functions_lib",
        ":sas_model_lib",
    ]
)

# Semantic checks on a parsed model (undeclared ids, features the solver lacks).
cc_library(
    name = "sas_model_checker_lib",
    hdrs = [
        "ModelChecker.h",
    ],
    srcs = [
        "ModelChecker.cpp",
    ],
    deps = [
        ":sas_hybrid_model_lib",
        ":sas_model_lib",
    ]
)

# A sparse LU factorization (SuperLU) that is factored once and solved many times. It includes the
# SuperLU headers only, not Armadillo.
cc_library(
    name = "sas_sparse_lu_lib",
    hdrs = [
        "SparseLU.h",
    ],
    srcs = [
        "SparseLU.cpp",
    ],
    deps = [
        "//:superlu_lib",
    ],
)

# TODO - rygx: verify armadillo works with superlu
# can be done with a test solving an equation.
cc_library(
    name = "sas_computation_lib",
    hdrs = [
        "SasComputation.h",
    ],
    srcs = [
        "SasComputation.cpp",
    ],
    deps = [
        ":sas_lexico_lib",
        ":sas_result_types_lib",
        ":sas_sparse_lu_lib",
        "//util:abstract_che_calculator_lib",
        "//:superlu_lib",
    ]
)

# Result data types shared by the solver and the result writers (no numeric dependencies).
cc_library(
    name = "sas_result_types_lib",
    hdrs = [
        "SasResult.h",
    ],
)

# SasResult sampling and the JSON and CSV result writers .
cc_library(
    name = "sas_result_lib",
    srcs = [
        "SasResult.cpp",
    ],
    deps = [
        ":sas_computation_lib",
        ":sas_result_types_lib",
        "//:libjsoncpp",
    ]
)

# MAT v5 result writer.
cc_library(
    name = "sas_result_mat_lib",
    hdrs = [
        "SasResultMat.h",
    ],
    srcs = [
        "SasResultMat.cpp",
    ],
    deps = [
        ":sas_result_types_lib",
        "//io:mat5_writer_lib",
    ]
)

# Time-event simulation of flat hybrid models on top of the semi-analytical solver.
cc_library(
    name = "sas_hybrid_sim_lib",
    hdrs = [
        "HybridSimulator.h",
    ],
    srcs = [
        "HybridSimulator.cpp",
    ],
    deps = [
        ":sas_computation_lib",
        ":sas_hybrid_model_lib",
    ]
)

# One Modelica simulation as a library call: job (file or struct), run with progress and
# cancellation, sampled result. The command line and the C API sit on top of this.
cc_library(
    name = "sas_simulation_lib",
    hdrs = [
        "Simulation.h",
    ],
    srcs = [
        "Simulation.cpp",
    ],
    deps = [
        ":sas_computation_lib",
        ":sas_expr_parser_lib",
        ":sas_hybrid_model_lib",
        ":sas_hybrid_sim_lib",
        ":sas_model_checker_lib",
        ":sas_model_parser_lib",
        ":sas_result_lib",
        ":sas_result_mat_lib",
        "//:libjsoncpp",
    ],
)
