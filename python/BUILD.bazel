load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "gensas",
    srcs = ["gensas/__init__.py"],
    imports = ["."],
)

# Runs the Python interface against the shared library. Not built on Windows (Bazel has no Python
# interpreter there); the Windows CI job runs the same test file against gensas.dll instead.
py_test(
    name = "gensas_python_test",
    srcs = ["tests/test_gensas.py"],
    main = "tests/test_gensas.py",
    data = ["//capi:libgensas.so"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":gensas"],
)
