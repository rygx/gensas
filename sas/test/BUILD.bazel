load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "test_util",
    hdrs = ["test_util.h"],
)

# Parser-only test; builds without the numeric dependencies (BLAS, SuperLU, ...).
cc_test(
    name = "parser_test",
    srcs = ["parser_test.cpp"],
    deps = [
        ":test_util",
        "//sas:sas_model_parser_lib",
    ],
)

# Hybrid Modelica subset: parser structure and model checker.
cc_test(
    name = "hybrid_parser_test",
    srcs = ["hybrid_parser_test.cpp"],
    deps = [
        ":test_util",
        "//sas:sas_model_checker_lib",
        "//sas:sas_model_parser_lib",
    ],
)

# Parse -> DAE -> SAS solve of resources/mofile/test_solve_ode.mo against expm().
cc_test(
    name = "ode_regression_test",
    srcs = ["ode_regression_test.cpp"],
    deps = [
        ":test_util",
        "//sas:sas_computation_lib",
        "//sas:sas_expr_parser_lib",
        "//sas:sas_model_parser_lib",
        "//util:safe_armadillo_headers",
    ],
)

# Evaluation, specialization and time-event scheduling of hybrid models (no solver needed).
cc_test(
    name = "hybrid_model_test",
    srcs = ["hybrid_model_test.cpp"],
    deps = [
        ":test_util",
        "//sas:sas_hybrid_model_lib",
        "//sas:sas_model_checker_lib",
        "//sas:sas_model_parser_lib",
    ],
)

# Time-event simulation end to end, compared with closed-form solutions.
cc_test(
    name = "hybrid_sim_test",
    srcs = ["hybrid_sim_test.cpp"],
    deps = [
        ":test_util",
        "//:libjsoncpp",
        "//sas:sas_hybrid_sim_lib",
        "//sas:sas_result_lib",
        "//sas:sas_model_checker_lib",
        "//sas:sas_model_parser_lib",
        "//util:safe_armadillo_headers",
    ],
)

# Solver with an algebraic equation (guards the Pade coefficient cache during AE calibration).
cc_test(
    name = "dae_regression_test",
    srcs = ["dae_regression_test.cpp"],
    deps = [
        ":test_util",
        "//sas:sas_computation_lib",
        "//sas:sas_expr_parser_lib",
        "//sas:sas_model_parser_lib",
        "//util:safe_armadillo_headers",
    ],
)

# Result sampling and the JSON and CSV writers.
cc_test(
    name = "result_test",
    srcs = ["result_test.cpp"],
    deps = [
        ":test_util",
        "//:libjsoncpp",
        "//sas:sas_hybrid_sim_lib",
        "//sas:sas_model_checker_lib",
        "//sas:sas_model_parser_lib",
        "//sas:sas_result_lib",
        "//util:safe_armadillo_headers",
    ],
)

# MAT v5 writer, read back with matio (needs the real matio, so the local script skips it).
cc_test(
    name = "result_mat_test",
    srcs = ["result_mat_test.cpp"],
    deps = [
        ":test_util",
        "//sas:sas_hybrid_sim_lib",
        "//sas:sas_model_checker_lib",
        "//sas:sas_model_parser_lib",
        "//sas:sas_result_lib",
        "//sas:sas_result_mat_lib",
        "//util:safe_armadillo_headers",
    ] + select({
        "//:windows": ["//:libmatio_lib_cmake"],
        "//conditions:default": ["//:libmatio_lib"],
    }),
)
